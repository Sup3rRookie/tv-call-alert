# Copy to keystore.properties (which is gitignored) and fill in.
# Keep the keystore itself outside the repository and back it up: updates to the app on the
# TV must be signed with the same key or the TV will refuse them.
storeFile=C:/Users/YOU/.keystores/tv-call-alert/release.p12
storePassword=CHANGE_ME
keyAlias=tvcallalert
keyPassword=CHANGE_ME
